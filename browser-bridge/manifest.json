{
  "manifest_version": 3,
  "name": "ONES Browser Bridge",
  "version": "0.5.4",
  "description": "Configuration-driven ONES inventory, field read, and gated root-cause write executor for a loopback Local Relay.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ONES Bridge",
    "default_popup": "popup.html"
  }
}
